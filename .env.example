# ==================== 应用配置 ====================
APP_PORT=3000
APP_BIND=127.0.0.1
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=
NEXT_PUBLIC_SITE_URL=https://www.aipan.me

# ==================== 短剧数据源（kkpan） ====================
# kkpan 站点根地址（条目同步调用其公开 API
# /api/resources/public?category_slug=short-drama&platform=quark）。
# 未配置时后台条目同步不可用。
KKPAN_API_BASE_URL=
# 网盘凭证加密密钥（AES-256-GCM 派生源；缺省回退 ADMIN_SESSION_SECRET/ADMIN_PASSWORD）
# 更换后旧凭证无法解密，需在后台重新粘贴
CREDENTIAL_ENCRYPTION_KEY=

# ==================== 短剧封面 R2 镜像 ====================
# 与 kerkerker-douban-service 同一组 Worker 通道，可与豆瓣图片共用 Bucket
# （douban-service 用 CLOUDFLARE_R2_KEY_PREFIX（缺省 douban-images），短剧
# 刻意用独立的 COVER_KEY_PREFIX（缺省 short-drama-covers），互不覆盖）：
#   CLOUDFLARE_R2_PUBLIC_URL        Bucket 根目录的公开访问域名
#   CLOUDFLARE_R2_UPLOAD_API_URL    上传 Worker /objects 基址
#   CLOUDFLARE_R2_UPLOAD_API_TOKEN  Bearer token（Worker 的 UPLOAD_TOKEN）
#   CLOUDFLARE_R2_COVER_KEY_PREFIX  对象键顶层目录（缺省 short-drama-covers）
#   CLOUDFLARE_R2_MAX_IMAGE_BYTES   大小上限（缺省 10MB）
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_UPLOAD_API_URL=
CLOUDFLARE_R2_UPLOAD_API_TOKEN=
CLOUDFLARE_R2_COVER_KEY_PREFIX=short-drama-covers
CLOUDFLARE_R2_MAX_IMAGE_BYTES=10485760

# ==================== SEO 主动推送（可选） ====================
# 百度搜索资源平台「普通收录」API token（platform.baidu.com 获取；留空则不推送）
BAIDU_PUSH_TOKEN=
# IndexNow 密钥（8-128 位 hex，自生成；同时经 /indexnow-key.txt 公开校验；留空则不推送）
INDEXNOW_KEY=
