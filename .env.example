# ==================== 应用配置 ====================
APP_PORT=3000
APP_BIND=127.0.0.1
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=
NEXT_PUBLIC_SITE_URL=https://www.aipan.me
NEXT_PUBLIC_DOUBAN_API_URL=
KERKERKER_PLUGIN_PROFILE=cn-default
# 生产默认由 NODE_ENV=production 强制开启；可在非 production 主机显式设为 true 进行门禁验收。
KERKERKER_PLUGIN_INSTALLATION_ENFORCE=true
# en-default 使用 Go 服务承载的 TMDB 插件；TMDB_API_KEY 只配置在 Go 服务。
TMDB_PLUGIN_URL=https://iamyourfather.link0.me/plugin
TMDB_PLUGIN_SERVICE_TOKEN=
# 可选：宿主 asset.image 镜像到 Cloudflare R2。配置完整后详情接口会按 content_id 持久化镜像台账。
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_UPLOAD_API_URL=
CLOUDFLARE_R2_UPLOAD_API_TOKEN=
CLOUDFLARE_R2_MAX_IMAGE_BYTES=10485760
# 合规策略模式：audit 只记录并提示，enforce 对未审批/已下架插件拒绝调用。
KERKERKER_COMPLIANCE_MODE=audit
# 运行区域用于策略匹配；不从请求参数推断。
KERKERKER_PLUGIN_REGION=CN
# 审计记录中的管理员稳定标识，不要写入密码或会话值。
ADMIN_AUDIT_ACTOR_ID=admin-session
# Go/Sidecar worker 写入通用任务进度的 32–512 位 URL-safe 独立 Bearer 密钥；为空时接收器拒绝所有请求。
KERKERKER_JOB_REPORT_TOKEN=
NEXT_PUBLIC_DANMU_API_URL=
NEXT_PUBLIC_DANMU_API_TOKEN=

# kkpans.com 资源拉取（自家网盘资源站，后台录入辅助）
KKPAN_API_BASE=https://www.kkpans.com
# 可选：定时同步 POST 的 Bearer 密钥（也可使用 Vercel 的 CRON_SECRET；
# 不配置则必须使用管理员登录 cookie）
KKPAN_SYNC_CRON_SECRET=
# 兼容 Vercel Cron / 其它调度器的同名密钥（与上面二选一）
CRON_SECRET=

# 应用内影片网盘同步调度器。后台按任务分别启用；默认关闭，避免首次部署立即请求上游。
# 启用后不需要服务器 crontab，配置和运行记录保存在 MongoDB。
PAN_SYNC_SCHEDULER_DISABLED=false
# 轮询调度配置的间隔（毫秒，10 秒到 10 分钟，默认 30000）。
PAN_SYNC_SCHEDULER_POLL_MS=30000
# KKPAN 目录通用任务迁移开关：off（默认）、shadow（双写不可执行）、cutover（需先关闭旧执行器）。
PAN_SYNC_CATALOG_JOB_MODE=off

# ==================== 短剧源（short-drama 分支） ====================
# duanjugou.top 抓取源（缺省 https://duanjugou.top，一般无需配置）
DUANJUGOU_BASE_URL=
# 网盘凭证加密密钥（AES-256-GCM 派生源；缺省回退 ADMIN_SESSION_SECRET/ADMIN_PASSWORD）
# 更换后旧凭证无法解密，需在后台重新粘贴
CREDENTIAL_ENCRYPTION_KEY=
# 复用宿主 R2 镜像通道（与 kerkerker-douban-service 完全同一组变量、
# 同一个鉴权 Upload Worker，可与豆瓣图片共用 Bucket）：
# 短剧封面（转存夹内 封面.jpg）上传 R2 后以外链展示；未配置时封面留空。
# 对象键 = CLOUDFLARE_R2_KEY_PREFIX（缺省 short-drama-covers）/文章ID.jpg，
# douban-service 的 KEY_PREFIX 缺省 douban-images；共用 Bucket 时两者互不覆盖。
